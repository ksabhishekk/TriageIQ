# Copy to deploy/.env and set a strong password. deploy/.env is git-ignored — never commit it.
POSTGRES_USER=triageiq
POSTGRES_DB=triageiq
POSTGRES_PASSWORD=change-me
# server only: the header value Vercel must send (same value set in Vercel as env var ORIGIN_SECRET)
ORIGIN_SECRET=change-me
# Keep off until split-graph parity, latency and memory checks pass on the target server.
XAI_ENABLED=0
